{
    "module_id": "viam:switchbot",
    "visibility": "public",
    "url": "https://github.com/viam-labs/switchbot",
    "description": "Control SwitchBot devices (Bot, Curtain, Meter) via the SwitchBot OpenAPI v1.1.",
    "models": [
        {
            "api": "rdk:component:switch",
            "model": "viam:switchbot:bot",
            "markdown_link": "README.md#bot"
        },
        {
            "api": "rdk:component:generic",
            "model": "viam:switchbot:curtain",
            "markdown_link": "README.md#curtain"
        },
        {
            "api": "rdk:component:sensor",
            "model": "viam:switchbot:meter",
            "markdown_link": "README.md#meter"
        }
    ],
    "entrypoint": "run.sh",
    "first_run": ""
}
